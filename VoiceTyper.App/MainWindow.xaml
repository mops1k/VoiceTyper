<Window x:Class="VoiceTyper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceTyper.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VoiceTyper — настройки"
        Height="640" Width="820"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/voiceTyper.ico"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                            ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:NavVisibilityConverter x:Key="NavVis" />
        <local:NavGlyphConverter x:Key="NavGlyph" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,0,0,8" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Control}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InfoGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="14,4,14,0" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF6EA1F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Text}" />
            <Setter Property="Background" Value="{DynamicResource Bg.ControlHover}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF5A5A5A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFF6B6B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FF6B6B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Bg.ControlHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="14,11"
                                Margin="0,2" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Toggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Bg.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <Border Grid.Row="0" Background="{DynamicResource Bg.Control}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1" shell:WindowChrome.IsHitTestVisibleInChrome="False">
            <Grid>
                <TextBlock Text="VoiceTyper" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource Fg.Text}" FontSize="13" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="&#xE921;" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#xE922;" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#xE8BB;" Style="{StaticResource TitleBarButton}" Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Тело -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Навигация слева -->
            <StackPanel Grid.Column="0" Margin="10,14,10,10">
                <StackPanel Orientation="Horizontal" Margin="12,0,12,18">
                    <Image Source="Assets/voiceTyper.png" Width="34" Height="34" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VoiceTyper" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="голосовой ввод" FontSize="11" Foreground="{DynamicResource Fg.Muted}" />
                    </StackPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Text="{Binding Converter={StaticResource NavGlyph}}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontSize="14" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Содержимое -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="14,14,14,10">
                <StackPanel>

                    <!-- Основные -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Основные}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="ОСНОВНЫЕ" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Язык распознавания" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="Язык, на котором распознаётся речь. «Авто» — определять автоматически." />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180"
                                              ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Режим записи" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="«Удержание» — запись, пока зажата клавиша. «Переключатель» — нажал/нажал. «Авто» — остановка по тишине." />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180"
                                              ItemsSource="{Binding RecordingModes}" SelectedItem="{Binding RecordingMode}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Порог тишины, мс" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="Пауза (мс) в режиме «Авто», после которой запись считается завершённой." />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="180"
                                             Text="{Binding SilenceThresholdMs, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Температура" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="Строгость распознавания: 0 — детерминированно, выше — мягче." />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180"
                                              ItemsSource="{Binding Temperatures}" SelectedItem="{Binding Temperature}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <CheckBox Content="Подавлять фоновый шум"
                                          IsChecked="{Binding NoiseReductionEnabled}" Style="{StaticResource Toggle}" />
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <CheckBox Content="Учитывать контекст (для длинной речи)"
                                          IsChecked="{Binding ConditionOnPreviousText}" Style="{StaticResource Toggle}" />
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <CheckBox Content="Автоматически вставлять текст (Ctrl+V)"
                                          IsChecked="{Binding AutoPasteEnabled}" Style="{StaticResource Toggle}" />
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Технические термины" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="Слова добавляются в промпт модели для точного распознавания (например API, JSON, IDE)." />
                                    </StackPanel>
                                    <TextBox Margin="0,10,0,0" Text="{Binding TermsDictionary, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" Height="58" VerticalScrollBarVisibility="Hidden"
                                             VerticalContentAlignment="Top" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Слова добавляются в промпт модели для точного распознавания (например API, JSON, IDE)." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- Внешний вид -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Внешний вид}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="ВНЕШНИЙ ВИД" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Тема оформления" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="«Авто» — следовать теме Windows. «Светлая»/«Тёмная» — вручную." />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180"
                                              ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <CheckBox Content="Сворачивать окно настроек при потере фокуса"
                                          IsChecked="{Binding HideOnFocusLoss}" Style="{StaticResource Toggle}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- Модели -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Модели}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="МОДЕЛИ" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding ModelItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Command="{Binding DataContext.SelectModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" Style="{StaticResource Toggle}"
                                                      Margin="0,0,12,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowLabel}" />
                                                    <TextBlock Text="{Binding ApproxSize}" Foreground="{DynamicResource Fg.Muted}"
                                                               FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Fg.Muted}"
                                                           FontSize="12" TextWrapping="Wrap" Margin="0,3,12,0" />
                                                <TextBlock Text="{Binding Speed}" Foreground="{DynamicResource Fg.Muted}"
                                                           FontSize="11" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="Скачать" Style="{StaticResource SecondaryButton}"
                                                    Padding="14,6" Margin="10,0,8,0" VerticalAlignment="Center"
                                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.DownloadModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Grid.Column="3" Content="&#xE74D;"
                                                    Style="{StaticResource DangerIconButton}"
                                                    ToolTip="Удалить с диска" VerticalAlignment="Center"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanDelete}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    </StackPanel>

                    <!-- Горячие клавиши -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Горячие клавиши}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="ГОРЯЧИЕ КЛАВИШИ" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Запись" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="Горячая клавиша записи. Кликните по полю и нажмите нужное сочетание." />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="180" Text="{Binding RecordHotkeyHint}"
                                             IsReadOnly="True" Focusable="False" Cursor="Hand"
                                             ToolTip="Кликните и нажмите нужное сочетание"
                                             PreviewMouseLeftButtonUp="CaptureRecordHotkey_Click">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Отмена" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="Горячая клавиша отмены записи и обработки." />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="180" Text="{Binding CancelHotkeyHint}"
                                             IsReadOnly="True" Focusable="False" Cursor="Hand"
                                             ToolTip="Кликните и нажмите нужное сочетание"
                                             PreviewMouseLeftButtonUp="CaptureCancelHotkey_Click">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                                           Text="Кликните по полю и нажмите нужное сочетание (например Ctrl+Alt+Space). Escape — отмена." />
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- Микрофон -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Микрофон}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="МИКРОФОН" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Устройство" Style="{StaticResource RowLabel}" />
                                    </StackPanel>
                                    <DockPanel Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="Обновить" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding RefreshMicrophonesCommand}" Margin="8,0,0,0" Padding="14,7" />
                                        <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                                                  DisplayMemberPath="Name" Width="280" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding MicrophoneStatus}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- Запуск -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Запуск}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="ЗАПУСК" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <CheckBox Content="Запускать вместе с Windows" IsChecked="{Binding StartWithWindows}"
                                          Style="{StaticResource Toggle}" />
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <CheckBox Content="Запускать свёрнутым в трей" IsChecked="{Binding StartMinimized}"
                                          Style="{StaticResource Toggle}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- О программе -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=О программе}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="О ПРОГРАММЕ" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" LineHeight="22" TextAlignment="Justify">
                                        <Run Text="VoiceTyper — программа голосового ввода текста. Нажмите горячую клавишу, проговорите текст, и он будет распознан и вставлен в активное поле или скопирован в буфер обмена." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" LineHeight="22" TextAlignment="Justify">
                                        <Run Text="Распознавание выполняется локально (Whisper) — аудио и текст не покидают устройство." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Версия" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="Текущая версия приложения." />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="1.0.0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg.Muted}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Логи" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="Файл журнала: %LOCALAPPDATA%\VoiceTyper\logs\voiceTyper.log" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="%LOCALAPPDATA%\VoiceTyper\logs\voiceTyper.log"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Fg.Muted}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Нижняя панель -->
        <Grid Grid.Row="2" Margin="18,10,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Fg.Muted}" FontSize="12" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFF6B6B" TextWrapping="Wrap" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}"
                            Margin="0,6,0,0">
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="1" Height="5"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Bg.ControlHover}" />
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Отмена" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelDownloadCommand}" Padding="12,4" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding DownloadInfo}" Foreground="{DynamicResource Fg.Muted}"
                                   FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Сбросить" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ResetDefaultsCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
