<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <AssemblyName>VoiceTyper</AssemblyName>
        <RootNamespace>VoiceTyper.App</RootNamespace>
        <ApplicationIcon>Assets\voiceTyper.ico</ApplicationIcon>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <!-- Оставляем только win-x64/win-x86 runtime-нативности и локализацию RU (EN — инвариантная) -->
    <Target Name="TrimOutput" AfterTargets="Build;Publish">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$d='$(TargetDir)'; $rt=Join-Path $d 'runtimes'; if (Test-Path $rt) { Get-ChildItem $rt -Directory | Where-Object { $_.Name -notin @('win-x64','win-x86') } | Remove-Item -Recurse -Force }; if (Test-Path $d) { Get-ChildItem $d -Directory | Where-Object { $_.Name -notin @('ru','runtimes','Assets') -and $_.Name -match '^[a-z]{2}(-[A-Za-z]{2,4})?$' } | Remove-Item -Recurse -Force }&quot;" />
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\VoiceTyper.Core\VoiceTyper.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="Assets\voiceTyper.ico" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="Assets\voiceTyper.png" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="Assets\voiceTyper_dark.ico" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="Assets\voiceTyper_dark.png" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="Assets\voiceTyper_light.ico" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="Assets\voiceTyper_light.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <None Include="Native\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
      <PackageReference Include="NHotkey.Wpf" Version="4.0.0" />
      <PackageReference Include="WindowsInput" Version="6.4.1" />
    </ItemGroup>

</Project>
