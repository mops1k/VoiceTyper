<Window x:Class="VoiceTyper.App.Overlay.StatusOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Grid Margin="0,0,0,26">
        <Border Background="{StaticResource Bg.Control}"
                BorderBrush="{StaticResource Accent}"
                BorderThickness="1.5"
                CornerRadius="16"
                Padding="20,11"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="#FF000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="11" Height="11" Fill="{StaticResource Accent}"
                         VerticalAlignment="Center" Margin="0,0,11,0" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Fg.Text}"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
