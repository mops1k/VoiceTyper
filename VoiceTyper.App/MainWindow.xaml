<Window x:Class="VoiceTyper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceTyper.App"
        xmlns:loc="clr-namespace:VoiceTyper.Core.Localization;assembly=VoiceTyper.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding [App_WindowTitle], Source={x:Static loc:Loc.Instance}}"
        Height="640" Width="820"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/voiceTyper.ico"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0"
                            ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:NavVisibilityConverter x:Key="NavVis" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,0,0,8" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Control}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InfoGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="14,4,14,0" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF6EA1F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Text}" />
            <Setter Property="Background" Value="{DynamicResource Bg.ControlHover}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF5A5A5A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFF6B6B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FF6B6B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Bg.ControlHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="14,11"
                                Margin="0,2" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Toggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Bg.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <Border Grid.Row="0" Background="{DynamicResource Bg.Control}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1" shell:WindowChrome.IsHitTestVisibleInChrome="False">
            <Grid>
                <TextBlock Text="VoiceTyper" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource Fg.Text}" FontSize="13" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="&#xE921;" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#xE922;" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#xE8BB;" Style="{StaticResource TitleBarButton}" Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Тело -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Навигация слева -->
            <StackPanel Grid.Column="0" Margin="10,14,10,10">
                <StackPanel Orientation="Horizontal" Margin="12,0,12,18">
                    <Image Source="Assets/voiceTyper.png" Width="34" Height="34" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VoiceTyper" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="{Binding [Nav_AppTagline], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="11" Foreground="{DynamicResource Fg.Muted}" />
                    </StackPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedValuePath="Key" SelectedValue="{Binding SelectedNavItem}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Text="{Binding Glyph}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontSize="14" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Содержимое -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="14,14,14,10">
                <StackPanel>

                    <!-- Основные -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Main}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [General_Title], Source={x:Static loc:Loc.Instance}}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [General_RecognitionLanguage], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [General_RecognitionLanguage_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180"
                                              ItemsSource="{Binding Languages}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Language}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [General_InterfaceLanguage], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [General_InterfaceLanguage_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180"
                                              ItemsSource="{Binding UiLanguages}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding AppLanguage}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [General_RecordingMode], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [General_RecordingMode_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180"
                                              ItemsSource="{Binding RecordingModes}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding RecordingMode}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [General_SilenceThreshold], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [General_SilenceThreshold_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="180"
                                             Text="{Binding SilenceThresholdMs, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [General_Temperature], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [General_Temperature_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180"
                                              ItemsSource="{Binding Temperatures}" SelectedItem="{Binding Temperature}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <CheckBox Content="{Binding [General_NoiseReduction], Source={x:Static loc:Loc.Instance}}"
                                          IsChecked="{Binding NoiseReductionEnabled}" Style="{StaticResource Toggle}" />
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <CheckBox Content="{Binding [General_ConditionOnPreviousText], Source={x:Static loc:Loc.Instance}}"
                                          IsChecked="{Binding ConditionOnPreviousText}" Style="{StaticResource Toggle}" />
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <CheckBox Content="{Binding [General_AutoPaste], Source={x:Static loc:Loc.Instance}}"
                                          IsChecked="{Binding AutoPasteEnabled}" Style="{StaticResource Toggle}" />
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [General_Terms], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [General_Terms_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                    <TextBox Margin="0,10,0,0" Text="{Binding TermsDictionary, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" Height="58" VerticalScrollBarVisibility="Hidden"
                                             VerticalContentAlignment="Top" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="{Binding [General_Terms_Hint], Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- Внешний вид -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Appearance}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Look_Title], Source={x:Static loc:Loc.Instance}}" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Look_Theme], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [Look_Theme_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180"
                                              ItemsSource="{Binding Themes}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <CheckBox Content="{Binding [Look_HideOnFocusLoss], Source={x:Static loc:Loc.Instance}}"
                                          IsChecked="{Binding HideOnFocusLoss}" Style="{StaticResource Toggle}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- Модели -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Models}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Models_Title], Source={x:Static loc:Loc.Instance}}" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding ModelItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Command="{Binding DataContext.SelectModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" Style="{StaticResource Toggle}"
                                                      Margin="0,0,12,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowLabel}" />
                                                    <TextBlock Text="{Binding ApproxSize}" Foreground="{DynamicResource Fg.Muted}"
                                                               FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Fg.Muted}"
                                                           FontSize="12" TextWrapping="Wrap" Margin="0,3,12,0" />
                                                <TextBlock Text="{Binding Speed}" Foreground="{DynamicResource Fg.Muted}"
                                                           FontSize="11" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="{Binding [Models_Download], Source={x:Static loc:Loc.Instance}}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="14,6" Margin="10,0,8,0" VerticalAlignment="Center"
                                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.DownloadModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Grid.Column="3" Content="&#xE74D;"
                                                    Style="{StaticResource DangerIconButton}"
                                                    ToolTip="{Binding [Models_Delete_Tooltip], Source={x:Static loc:Loc.Instance}}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanDelete}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    </StackPanel>

                    <!-- Горячие клавиши -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Hotkeys}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Hotkeys_Title], Source={x:Static loc:Loc.Instance}}" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Hotkeys_Record], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [Hotkeys_Record_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="180" Text="{Binding RecordHotkeyHint}"
                                             IsReadOnly="True" Focusable="False" Cursor="Hand"
                                             ToolTip="{Binding [Hotkeys_FieldHint], Source={x:Static loc:Loc.Instance}}"
                                             PreviewMouseLeftButtonUp="CaptureRecordHotkey_Click">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Hotkeys_Cancel], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [Hotkeys_Cancel_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="180" Text="{Binding CancelHotkeyHint}"
                                             IsReadOnly="True" Focusable="False" Cursor="Hand"
                                             ToolTip="{Binding [Hotkeys_FieldHint], Source={x:Static loc:Loc.Instance}}"
                                             PreviewMouseLeftButtonUp="CaptureCancelHotkey_Click">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                                           Text="{Binding [Hotkeys_Hint], Source={x:Static loc:Loc.Instance}}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- Микрофон -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Microphone}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Mic_Title], Source={x:Static loc:Loc.Instance}}" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Mic_Device], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                    </StackPanel>
                                    <DockPanel Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="{Binding [Mic_Refresh], Source={x:Static loc:Loc.Instance}}"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding RefreshMicrophonesCommand}" Margin="8,0,0,0" Padding="14,7" />
                                        <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                                                  DisplayMemberPath="Name" Width="280" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding MicrophoneStatus}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- Запуск -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=Startup}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [Startup_Title], Source={x:Static loc:Loc.Instance}}" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <CheckBox Content="{Binding [Startup_WithWindows], Source={x:Static loc:Loc.Instance}}"
                                          IsChecked="{Binding StartWithWindows}"
                                          Style="{StaticResource Toggle}" />
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <CheckBox Content="{Binding [Startup_Minimized], Source={x:Static loc:Loc.Instance}}"
                                          IsChecked="{Binding StartMinimized}"
                                          Style="{StaticResource Toggle}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- О программе -->
                    <StackPanel Visibility="{Binding SelectedNavItem, Converter={StaticResource NavVis}, ConverterParameter=About}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [About_Title], Source={x:Static loc:Loc.Instance}}" Margin="6,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" LineHeight="22" TextAlignment="Justify">
                                        <Run Text="{Binding [About_Description1], Source={x:Static loc:Loc.Instance}, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" LineHeight="22" TextAlignment="Justify">
                                        <Run Text="{Binding [About_Description2], Source={x:Static loc:Loc.Instance}, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [About_Version], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [About_Version_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg.Muted}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding [Update_Title], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                            <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [Update_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding [Update_Check], Source={x:Static loc:Loc.Instance}}" Padding="14,7"
                                                Command="{Binding CheckForUpdatesCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding UpdateStatus}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,8,0,0" Foreground="{DynamicResource Fg.Muted}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolVis}}"
                                                Margin="0,10,0,0">
                                        <TextBlock Text="{Binding [Update_NewAvailable], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Fg.Text}" />
                                        <TextBlock Text="{Binding ReleaseNotes}" FontSize="11" Foreground="{DynamicResource Fg.Muted}"
                                                   TextWrapping="Wrap" MaxHeight="90" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReleaseNotes}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ReleaseNotes}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Content="{Binding [Update_Install], Source={x:Static loc:Loc.Instance}}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                Command="{Binding InstallUpdateCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolVis}}"
                                                Margin="0,10,0,0">
                                        <ProgressBar Value="{Binding UpdateDownloadProgress}" Maximum="1" Height="5"
                                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource Bg.ControlHover}" />
                                        <DockPanel Margin="0,6,0,0">
                                            <Button DockPanel.Dock="Right" Content="{Binding [App_Cancel], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding CancelUpdateDownloadCommand}" Padding="12,4" Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource Fg.Muted}"
                                                       FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [About_Logs], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [About_Logs_Tooltip], Source={x:Static loc:Loc.Instance}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="%LOCALAPPDATA%\VoiceTyper\logs\voiceTyper.log"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Fg.Muted}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Нижняя панель -->
        <Grid Grid.Row="2" Margin="18,10,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Fg.Muted}" FontSize="12" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFF6B6B" TextWrapping="Wrap" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}"
                            Margin="0,6,0,0">
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="1" Height="5"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Bg.ControlHover}" />
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="{Binding [App_Cancel], Source={x:Static loc:Loc.Instance}}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelDownloadCommand}" Padding="12,4" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding DownloadInfo}" Foreground="{DynamicResource Fg.Muted}"
                                   FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding [App_Reset], Source={x:Static loc:Loc.Instance}}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ResetDefaultsCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
